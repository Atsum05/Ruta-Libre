# Copy to apps/api/.env for local development. Every variable is validated in src/config.ts;
# the API refuses to start if one is malformed. All are optional locally.

# PORT=8787
# APP_ENV=local          # local | preview | production
# COMMIT_SHA=            # set by CI/hosting; Render provides RENDER_GIT_COMMIT automatically

# Live status (all optional; defaults shown)
# STATUS_SOURCE_URL=https://velocidades.seguimos.cl/?metro=1&all=1
# STATUS_POLL_SECONDS=120        # 60..3600; agreed rate is 1–2 min
# STATUS_TIMEOUT_MS=10000
# STATUS_MAX_AGE_MINUTES=780     # 13 h: the feed checks devices ~twice a day (ADR 0012)

# Trip planning. GOOGLE_MAPS_API_KEY is required when APP_ENV is preview or production.
# Restrict it to the Routes and Places APIs (it never reaches the browser, ADR 0004).
# GOOGLE_MAPS_API_KEY=
# GEMINI_API_KEY=                 # optional: without it, /v1/interpret answers 503
# GEMINI_MODEL=gemini-3.1-flash-lite
# UPSTREAM_TIMEOUT_MS=8000
# TRUST_PROXY=false              # true behind Render, to rate-limit by X-Forwarded-For
# CORS_ORIGINS=                  # comma-separated; production is same-origin via Netlify

# Demo mode (ADR 0014): show the last known elevator statuses as if current, clearly labelled
# in the app. For demos while the status feed is frozen; never for real users.
# STATUS_DEMO=false
