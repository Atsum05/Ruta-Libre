# Copy to apps/web/.env.local for local development (gitignored). Validated in src/config.ts;
# `pnpm dev` and `pnpm build` refuse to run if a value is missing or malformed.
#
# VITE_* values are compiled into the JavaScript and visible to every visitor. Only the Maps
# JavaScript key belongs here (ADR 0009): restrict it to your domains and to that one API.

VITE_GOOGLE_MAPS_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=   # optional until we use advanced markers / cloud styling
